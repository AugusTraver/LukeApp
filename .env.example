# Copiá este archivo como .env.local (desarrollo) y cargá los mismos valores en Vercel.
# Sin las variables de Supabase la app funciona en "modo demo" (datos solo en este navegador).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (service role). SOLO servidor, nunca con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Avisos push. Generalas con:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# Secretos largos y aleatorios (por ejemplo: openssl rand -base64 32)
CRON_SECRET=
PUSH_ACTION_SECRET=
